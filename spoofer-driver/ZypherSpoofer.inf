[Version]
Signature = "$Windows NT$"
Class = System
ClassGuid = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider = %ManufacturerName%
CatalogFile = ZypherSpoofer.cat
DriverVer = 06/30/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
ZypherSpoofer.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...17763

[Standard.NT$ARCH$.10.0...17763]
%ZypherSpoofer.DeviceDesc% = ZypherSpoofer_Device, Root\ZypherSpoofer

[ZypherSpoofer_Device.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
ZypherSpoofer.sys

[ZypherSpoofer_Device.NT.Services]
AddService = ZypherSpoofer,%SPSVCINST_ASSOCSERVICE%, ZypherSpoofer_Service_Inst

[ZypherSpoofer_Service_Inst]
DisplayName    = %ZypherSpoofer.SVCDESC%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\ZypherSpoofer.sys

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "Zypher"
DiskId1 = "Zypher Spoofer Installation Disk"
ZypherSpoofer.DeviceDesc = "Zypher HWID Spoofer"
ZypherSpoofer.SVCDESC = "Zypher HWID Spoofer Driver"
